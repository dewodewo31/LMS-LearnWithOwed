# LMS API — environment template. Copy to .env.development / .env.production and fill real values.
# Secrets must never be committed.

NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/kn-lms

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS / frontend origin
FRONTEND_URL=http://localhost:5173

# Uploads
UPLOAD_PATH=./uploads

# Seed script (development only)
SEED_ADMIN_EMAIL=admin@lms.test
SEED_ADMIN_PASSWORD=admin12345
SEED_MENTOR_EMAIL=mentor@lms.test
SEED_MENTOR_PASSWORD=mentor12345
SEED_STUDENT_EMAIL=student@lms.test
SEED_STUDENT_PASSWORD=student12345
